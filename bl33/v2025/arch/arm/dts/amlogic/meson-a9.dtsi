      sdcard_pins: sdcard {
              mux {
                      groups = "sdcard_d0_ao",
                              "sdcard_d1_ao",
                              "sdcard_d2_ao",
                              "sdcard_d3_ao",
                              "sdcard_cmd_ao";
                      function = "sdcard_ao";
                      bias-pull-up;
                      input-enable;
                      drive-strength = <4>;
              };
              mux1 {
                      groups ="sdcard_clk_ao";
                      function = "sdcard_ao";
                      bias-pull-up;
                      output-high;
                      drive-strength = <4>;
              };
      };

      sdcard_clk_gate_pins: sdcard_clk_gate {
              mux {
                      groups = "sdcard_clk_ao";
                      function = "sdcard_ao";
                      bias-pull-down;
              };
      };

	spisg_a_pins_d: spisg_a_pins_d {
		mux {
			 /* GPIOD_3/4/5/6/7/2 */
			groups = "spi_a_mosi_ao",
				 "spi_a_miso_ao",
				 "spi_a_ss0_ao",
				 "spi_a_ss1_ao",
				 "spi_a_ss2_ao",
				 "spi_a_sclk_ao";
			function = "spi_a_ao";
			drive-strength-microamp = <3000>;
		};
	};


#
#Amlogic I2C control drivers
#

config SYS_I2C_MESON
	bool "Amlogic Meson SoC I2C driver"
	default n
	help
	  Say Y here if you want to use the Meson I2C control.

config SYS_I2C_MESON_V2
	bool "Amlogic Meson SoC I2C V2 driver"
	default n
	help
	  Say Y here if you want to use the Meson I2C V2 control.
